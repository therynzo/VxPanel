{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "pm2 start ecosystem.config.cjs --no-daemon",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "createuser": "node cli-tool.cjs createuser",
    "seed": "node cli-tool.cjs seed",
    "migrate": "node cli-tool.cjs migrate",
    "backup": "node cli-tool.cjs backup",
    "restore": "node cli-tool.cjs restore",
    "update": "git pull && npm install && npm run build && pm2 restart ecosystem.config.cjs",
    "doctor": "node cli-tool.cjs doctor",
    "repair": "node cli-tool.cjs repair",
    "reset-password": "node cli-tool.cjs reset-password",
    "logs": "node cli-tool.cjs logs",
    "restart-all": "node cli-tool.cjs repair"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pm2": "^7.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
